# App
DEBUG=true
ENVIRONMENT=development

# Host port for the API container; 8000 stays free for a local `uvicorn --reload`
API_PORT=8001

# Postgres credentials. Only applied when the postgres_data volume is first created.
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password

# Service addresses for running the app on the host.
# compose.yml overrides these with container hostnames for the api service.
POSTGRES_DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5432/rag_db
OPENSEARCH__HOST=http://localhost:9200

# Redis Cache Configuration
REDIS__HOST=redis
REDIS__PORT=6379
# Leave empty since compose.yml Redis has no --requirepass configured
REDIS__PASSWORD=
REDIS__DB=0
REDIS__TTL_HOURS=6



# PDF Parser Configuration
PDF_PARSER__MAX_PAGES=30
PDF_PARSER__MAX_FILE_SIZE_MB=20
PDF_PARSER__DO_OCR=false
PDF_PARSER__DO_TABLE_STRUCTURE=true


# Text Chunking Configuration
CHUNKING__CHUNK_SIZE=600
CHUNKING__OVERLAP_SIZE=100
CHUNKING__MIN_CHUNK_SIZE=100
CHUNKING__SECTION_BASED=true

# Ollama Configuration
OLLAMA__MODEL=gemma4:12b-mlx
OLLAMA__TIMEOUT=300
OLLAMA__EMBEDDING_MODEL=qwen3-embedding:4b


# OpenSearch Configuration (Single hybrid index for all search types)
OPENSEARCH__INDEX_NAME=rag-document
OPENSEARCH__CHUNK_INDEX_SUFFIX=chunks
OPENSEARCH__MAX_TEXT_SIZE=1000000

# Vector Search Settings
OPENSEARCH__VECTOR_DIMENSION=1024
OPENSEARCH__VECTOR_SPACE_TYPE=cosinesimil

# Hybrid Search Settings  
OPENSEARCH__RRF_PIPELINE_NAME=hybrid-rrf-pipeline
OPENSEARCH__HYBRID_SEARCH_SIZE_MULTIPLIER=2
